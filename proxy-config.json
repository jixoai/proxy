{
  "instances": [
    {
      "name": "default",
      "port": 27890,
      "enabled": true,
      "description": "默认创建的代理实例，可根据需要修改或删除",
      "headers": {
        "X-Proxy-By": "Proxy Toolbox"
      },
      "forwards": [
        {
          "name": "echo-service",
          "enabled": true,
          "target": "https://httpbin.org",
          "description": "示例转发规则，可快速验证代理链路",
          "path": null,
          "methods": [
            "*"
          ],
          "headers": null
        }
      ]
    },
    {
      "name": "llm-lab",
      "port": 20002,
      "enabled": true,
      "description": "Proxy Viewer 中常用的 LLM 请求调试实例",
      "headers": null,
      "forwards": [
        {
          "name": "openai",
          "enabled": true,
          "target": "https://api.openai.com",
          "description": "将 /openai/* 请求转发到 OpenAI API",
          "path": "/openai",
          "methods": [
            "POST"
          ],
          "headers": {
            "x-extra-debug": "llm-lab"
          }
        },
        {
          "name": "anthropic",
          "enabled": false,
          "target": "https://api.anthropic.com",
          "description": "关闭状态下的示例，用于演示多规则配置",
          "path": "/anthropic",
          "methods": [
            "POST"
          ],
          "headers": null
        }
      ]
    }
  ]
}