{
  "name": "@jixo/proxy-plugin-anthropic4codex",
  "version": "0.1.0",
  "description": "Proxy plugin that converts Codex Responses API to Claude Messages API",
  "keywords": [
    "codex",
    "claude",
    "anthropic",
    "openai",
    "proxy",
    "api-conversion"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./request-converter": "./src/request-converter.ts",
    "./response-converter": "./src/response-converter.ts",
    "./plugin": "./src/plugin.ts"
  },
  "bin": {
    "proxy-plugin-anthropic4codex": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "ts": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@jixo/proxy-plugin": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  }
}
